contract IfElseExample
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  isRich(accountBalance: uint64): string
  {
    if (accountBalance > 1000) {
      return "This account is rich!"
    }
    if (accountBalance > 100) {
      return "This account is doing well."
    }
    return "This account is poor :("
  }
  
  isEven(number: uint64): string
  {
    return (number % 2 == 0 ? "Even" : "Odd")
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract ForLoopsExample
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  forLoop(): arc4.static_array<arc4.uint8,4>
  {
    array: arc4.static_array<arc4.uint8,4> = new arc4.static_array<arc4.uint8,4>(0, 0, 0, 0)
    for (temp in urange(0, 4, 1)) {
      index: uint64 = copy(temp)
      array[index]: arc4.uint8 = ARC4_ENCODE(3 - index, wtype=arc4.uint8)
    }
    x: uint64 = 0
    for (temp₁ in urange(1, 5, 1)) {
      item: uint64 = copy(temp₁)
      x: uint64 = x + item
    }
    assert(x == 10)
    return array
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract MatchStatements
