  }
  
  getDay(day: uint64): string
  {
    if (day == 0) {
      #switch₁ᶜ₀:
      return "Monday"
    }
    if (day == 1) {
      #switch₁ᶜ₁:
      return "Tuesday"
    }
    if (day == 2) {
      #switch₁ᶜ₂:
      return "Wednesday"
    }
    if (day == 3) {
      #switch₁ᶜ₃:
      return "Thursday"
    }
    if (day == 4) {
      #switch₁ᶜ₄:
      return "Friday"
    }
    if (day == 5) {
      #switch₁ᶜ₅:
      return "Saturday"
    }
    if (day == 6) {
      #switch₁ᶜ₆:
      return "Sunday"
    }
    #switch₁ᶜ₇:
    return "Invalid day"
  }
  
  __algots__.defaultCreate(): void
