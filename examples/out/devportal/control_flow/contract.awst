  }
  
}
contract WhileLoopExample
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  loop(): uint64
  {
    num: uint64 = 10
    loopCount: uint64 = 0
    while (num > 0) {
      if (num > 5) {
        num: uint64 = num - 1
        loopCount: uint64 = loopCount + 1
        goto #loop₁ᶜ
      }
      num: uint64 = num - 2
      loopCount: uint64 = loopCount + 1
      if (num == 1) {
        goto #loop₁ᵇ
      }
      #loop₁ᶜ:
    }
    #loop₁ᵇ:
    return loopCount
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}