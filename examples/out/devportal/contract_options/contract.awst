contract OnChainName
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  hello(): string
  {
    return "hello"
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract ContractWithStateReservation
{
  globals {
    ["counter"]: uint64
    ["label"]: bytes
  }
  approvalProgram(): bool
  {
    if (!Boolean(txn<ApplicationID>())) {
      this.constructor()
    }
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  increment(): uint64
  {
    GlobalState["counter"]: uint64 = GlobalState["counter"] + 1
    return GlobalState["counter"]
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
  constructor(): void
  {
    super.constructor()
    GlobalState["counter"]: uint64 = 0
    GlobalState["label"]: bytes = 0x
  }
  
  BaseContract::constructor(): void
  {
  }
  
}
contract ContractWithScratchReservation
{
  reservedScratchSpace: [200, 201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 230, 231, 232, 233, 234, 235, 236, 237, 238, 239, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249, 250, 251, 252, 253, 254, 255]
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  echo(x: uint64): uint64
  {
    for (temp in urange(200, 255, 1)) {
      i: uint64 = copy(temp)
      stores(i, x)
    }
    return x
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
