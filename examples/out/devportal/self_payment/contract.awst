
logicsig examples/devportal/self_payment/contract.algo.ts::SelfPayment {
  currentTxn: group_transaction_pay = group_transaction(index=txn<GroupIndex>(), type=group_transaction_pay)
  return gtxns<Receiver>(currentTxn) == gtxns<Sender>(currentTxn) and gtxns<Amount>(currentTxn) == 0 and gtxns<RekeyTo>(currentTxn) == global<ZeroAddress>() and gtxns<CloseRemainderTo>(currentTxn) == global<ZeroAddress>() and gtxns<Fee>(currentTxn) == global<MinTxnFee>() and reinterpret_cast<bytes>(global<GenesisHash>()) == TemplateVar[bytes](TMPL_TARGET_NETWORK_GENESIS) and gtxns<LastValid>(currentTxn) == TemplateVar[uint64](TMPL_LAST_ROUND) and gtxns<Lease>(currentTxn) == sha256("self-payment")
}