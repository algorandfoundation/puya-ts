contract LocalStorage
{
  locals {
    ["localInt"]: uint64
    ["localBytes"]: bytes
    ["localBool"]: bool
    ["localAsset"]: asset
    ["localApplication"]: application
    ["localAccount"]: account
  }
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  optIn(): void
  {
    LocalState[txn<Sender>()]["localInt"]: uint64 = 10
    LocalState[txn<Sender>()]["localBytes"]: bytes = "Hello"
    LocalState[txn<Sender>()]["localBool"]: bool = True
    LocalState[txn<Sender>()]["localAsset"]: asset = reinterpret_cast<asset>(10)
    LocalState[txn<Sender>()]["localApplication"]: application = reinterpret_cast<application>(10)
    LocalState[txn<Sender>()]["localAccount"]: account = global<ZeroAddress>()
  }
  
  containsLocalData(forAccount: account): bool
  {
    return STATE_EXISTS(LocalState[forAccount]["localInt"])
  }
  
  containsLocalDataExample(forAccount: account): bool
  {
    assert(STATE_EXISTS(LocalState[forAccount]["localInt"]))
    assert(STATE_EXISTS(LocalState[forAccount]["localBytes"]))
    assert(STATE_EXISTS(LocalState[forAccount]["localBool"]))
    assert(STATE_EXISTS(LocalState[forAccount]["localAsset"]))
    assert(STATE_EXISTS(LocalState[forAccount]["localApplication"]))
    assert(STATE_EXISTS(LocalState[forAccount]["localAccount"]))
    return True
  }
  
  getItemLocalData(forAccount: account): uint64
  {
    return LocalState[forAccount]["localInt"]
  }
  
  getLocalDataWithDefaultInt(forAccount: account): uint64
  {
    return (STATE_EXISTS(LocalState[forAccount]["localInt"]) ? LocalState[forAccount]["localInt"] : 0)
  }
  
  maybeLocalData(forAccount: account): readonly [uint64, bool]
  {
    exists: bool = STATE_EXISTS(LocalState[forAccount]["localInt"])
    result: uint64 = (exists ? LocalState[forAccount]["localInt"] : 0)
    return #[result, exists]
  }
  
  getItemLocalDataExample(forAccount: account): bool
  {
    assert(LocalState[forAccount]["localInt"] == 10)
    assert(LocalState[forAccount]["localBytes"] == "Hello")
    assert(LocalState[forAccount]["localBool"])
    assert(LocalState[forAccount]["localAsset"] == reinterpret_cast<asset>(10))
    assert(LocalState[forAccount]["localApplication"] == reinterpret_cast<application>(10))
    assert(LocalState[forAccount]["localAccount"] == global<ZeroAddress>())
    return True
  }
  
  getLocalDataWithDefault(forAccount: account): bool
  {
    assert((STATE_EXISTS(LocalState[forAccount]["localInt"]) ? LocalState[forAccount]["localInt"] : 0) == 10)
    assert((STATE_EXISTS(LocalState[forAccount]["localBytes"]) ? LocalState[forAccount]["localBytes"] : "Default Value") == "Hello")
    assert((STATE_EXISTS(LocalState[forAccount]["localBool"]) ? LocalState[forAccount]["localBool"] : False))
    assert((STATE_EXISTS(LocalState[forAccount]["localAsset"]) ? LocalState[forAccount]["localAsset"] : reinterpret_cast<asset>(0)) == reinterpret_cast<asset>(10))
    assert((STATE_EXISTS(LocalState[forAccount]["localApplication"]) ? LocalState[forAccount]["localApplication"] : reinterpret_cast<application>(0)) == reinterpret_cast<application>(10))
    assert((STATE_EXISTS(LocalState[forAccount]["localAccount"]) ? LocalState[forAccount]["localAccount"] : global<ZeroAddress>()) == global<ZeroAddress>())
    return True
  }
  
  maybeLocalDataExample(forAccount: account): bool
  {
    assert(STATE_EXISTS(LocalState[forAccount]["localInt"]), comment=no data for account)
    assert(LocalState[forAccount]["localInt"] == 10)
    return True
  }
  
  setLocalInt(forAccount: account, value: uint64): void
  {
    LocalState[forAccount]["localInt"]: uint64 = value
  }
  
  setLocalDataExample(forAccount: account, valueAsset: asset, valueAccount: account, valueApp: application, valueBytes: bytes, valueBool: bool): bool
  {
    LocalState[forAccount]["localBytes"]: bytes = valueBytes
    assert(LocalState[forAccount]["localBytes"] == valueBytes)
    LocalState[forAccount]["localBool"]: bool = valueBool
    assert(LocalState[forAccount]["localBool"] == valueBool)
    LocalState[forAccount]["localAsset"]: asset = valueAsset
    assert(LocalState[forAccount]["localAsset"] == valueAsset)
    LocalState[forAccount]["localApplication"]: application = valueApp
    assert(LocalState[forAccount]["localApplication"] == valueApp)
    LocalState[forAccount]["localAccount"]: account = valueAccount
    assert(LocalState[forAccount]["localAccount"] == valueAccount)
    return True
  }
  
  deleteLocalData(forAccount: account): void
  {
    STATE_DELETE(LocalState[forAccount]["localInt"])
  }
  
  deleteLocalDataExample(forAccount: account): bool
  {
    STATE_DELETE(LocalState[forAccount]["localInt"])
    STATE_DELETE(LocalState[forAccount]["localBytes"])
    STATE_DELETE(LocalState[forAccount]["localBool"])
    STATE_DELETE(LocalState[forAccount]["localAsset"])
    STATE_DELETE(LocalState[forAccount]["localApplication"])
    STATE_DELETE(LocalState[forAccount]["localAccount"])
    return True
  }
  
  passProxyToSubroutine(forAccount: account): uint64
  {
    return examples/devportal/local_state/contract.algo.ts::readLocalIntPlus1("localInt", forAccount)
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
subroutine readLocalIntPlus1(state: state_key, account: account): uint64
{
  return LocalState[account][state] + 1
}
contract LocalStorageMap
{
  locals {
    ["balances"]: string => uint64
    ["flag"]: uint64 => bool
  }
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  optIn(): void
  {
    LocalState[txn<Sender>()][MapKey(prefix="balances", key="USD")]: uint64 = 100
    LocalState[txn<Sender>()][MapKey(prefix="flag", key=0)]: bool = True
  }
  
  getBalance(account: account, currency: string): uint64
  {
    return LocalState[account][MapKey(prefix="balances", key=currency)]
  }
  
  getBalanceOrDefault(account: account, currency: string): uint64
  {
    return (STATE_EXISTS(LocalState[account][MapKey(prefix="balances", key=currency)]) ? LocalState[account][MapKey(prefix="balances", key=currency)] : 0)
  }
  
  maybeBalance(account: account, currency: string): readonly [uint64, bool]
  {
    exists: bool = STATE_EXISTS(LocalState[account][MapKey(prefix="balances", key=currency)])
    result: uint64 = (exists ? LocalState[account][MapKey(prefix="balances", key=currency)] : 0)
    return #[result, exists]
  }
  
  hasFlag(account: account, key: uint64): bool
  {
    return STATE_EXISTS(LocalState[account][MapKey(prefix="flag", key=key)])
  }
  
  setBalance(account: account, currency: string, value: uint64): void
  {
    LocalState[account][MapKey(prefix="balances", key=currency)]: uint64 = value
  }
  
  setFlag(account: account, key: uint64, value: bool): void
  {
    LocalState[account][MapKey(prefix="flag", key=key)]: bool = value
  }
  
  deleteBalance(account: account, currency: string): void
  {
    STATE_DELETE(LocalState[account][MapKey(prefix="balances", key=currency)])
  }
  
  getSlotProxy(account: account, currency: string): uint64
  {
    slot: state_key = MapKey(prefix="balances", key=currency)
    return LocalState[account][slot]
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}