    "desc": "Demonstrates `GlobalMap`, a typed key->value collection backed by global\nstate. Each key consumes one global-state slot, so capacity must be sized on\nthe application via `stateTotals` at creation time, although it may be\nexpanded throughout the app's lifecycle. The numbers here are the per-app\nmaximums reserved for `scores` (uint) and `profiles` (bytes).",
    "networks": {},
    "state": {
        "schema": {
            "global": {
                "ints": 16,
                "bytes": 16
            },
            "local": {
                "ints": 0,
                "bytes": 0
            }
        },
        "keys": {
            "global": {},
            "local": {},
            "box": {}
        },
        "maps": {
            "global": {
