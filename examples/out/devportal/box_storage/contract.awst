contract BoxStorage
{
  boxes {
    ["boxInt"]: uint64
    ["b"]: arc4.dynamic_array<arc4.byte>
    ["BOX_STRING"]: arc4.dynamic_array<arc4.byte>
    ["BOX_BYTES"]: bytes
    [""]: uint64 => string
    ["users"]: uint64 => UserStruct
    ["boxNested"]: examples/devportal/box_storage/contract.algo.ts::NestedStruct
  }
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  getBox(): uint64
  {
    return Box["boxInt"].value
  }
  
  getItemBoxMap(key: uint64): string
  {
    return Box[MapKey(prefix="", key=key)].value
  }
  
  getBoxMap(): string
  {
    return STATE_GET(Box[MapKey(prefix="", key=1)].value, default="default")
  }
  
  maybeBox(): readonly [uint64, bool]
  {
    return STATE_GET_EX(Box["boxInt"].value)
  }
  
  maybeBoxMap(): readonly [string, bool]
  {
    #[value, exists]: readonly [string, bool] = #[($0 = STATE_GET_EX(Box[MapKey(prefix="", key=1)].value)).0, $0.1]
    return #[(exists ? value : ""), exists]
  }
  
  getBoxExample(): readonly [uint64, bytes, arc4.dynamic_array<arc4.byte>]
  {
    return #[Box["boxInt"].value, ARC4_DECODE(Box["b"].value), Box["BOX_STRING"].value]
  }
  
  getBoxMapStruct(key: uint64): UserStruct
  {
    return copy(Box[MapKey(prefix="users", key=key)].value)
  }
  
  readBoxPassedToSubroutine(key: uint64): string
  {
    return examples/devportal/box_storage/contract.algo.ts::getBoxMapValueFromKeyPlus1("", key)
  }
  
  setBox(value: uint64): void
  {
    Box["boxInt"].value: uint64 = value
  }
  
  setBoxMap(key: uint64, value: string): void
  {
    Box[MapKey(prefix="", key=key)].value: string = value
  }
  
  setBoxMapStruct(key: uint64, value: UserStruct): bool
  {
    Box[MapKey(prefix="users", key=key)].value: UserStruct = copy(value)
    assert(reinterpret_cast<bytes>(Box[MapKey(prefix="users", key=key)].value) == reinterpret_cast<bytes>(value), comment=stored struct must round-trip)
    return True
  }
  
  setBoxExample(valueInt: uint64, valueDbytes: arc4.dynamic_array<arc4.byte>, valueString: arc4.dynamic_array<arc4.byte>): void
  {
    Box["boxInt"].value: uint64 = valueInt
    Box["b"].value: arc4.dynamic_array<arc4.byte> = copy(valueDbytes)
    Box["BOX_STRING"].value: arc4.dynamic_array<arc4.byte> = valueString
    Box["BOX_BYTES"].value: bytes = ARC4_DECODE(valueDbytes)
    Box["boxInt"].value: uint64 = Box["boxInt"].value + 3
  }
  
  deleteBox(): void
  {
    STATE_DELETE(Box["boxInt"].value)
    STATE_DELETE(Box["b"].value)
    STATE_DELETE(Box["BOX_STRING"].value)
    assert(STATE_GET(Box["boxInt"].value, default=42) == 42, comment=box_int must be deleted)
    assert(ARC4_DECODE(STATE_GET(Box["b"].value, default=0x00023432)) == "42", comment=box_dynamic_bytes must be deleted)
    assert(ARC4_DECODE(STATE_GET(Box["BOX_STRING"].value, default="42")) == "42", comment=box_string must be deleted)
  }
  
  deleteBoxMap(key: uint64): void
  {
    STATE_DELETE(Box[MapKey(prefix="", key=key)].value)
  }
  
  boxIntLength(): uint64
  {
    return checked_maybe(box_len("boxInt"), comment=Box must have value)
  }
  
  boxMapLength(key: uint64): uint64
  {
    if (!STATE_EXISTS(Box[MapKey(prefix="", key=key)].value)) {
      return 0
    }
    return checked_maybe(box_len(MapKey(prefix="", key=key)), comment=Box must have value)
  }
  
  boxMapStructLength(): bool
  {
    value: UserStruct = new UserStruct(name=($1 = #{ name: "testName", id: 70, asset: 2 }).name, id=$1.id, asset=$1.asset)
    Box[MapKey(prefix="users", key=0)].value: UserStruct = copy(value)
    assert(len(reinterpret_cast<bytes>(Box[MapKey(prefix="users", key=0)].value)) == len(reinterpret_cast<bytes>(value)), comment=stored struct must have the same encoded length)
    assert(checked_maybe(box_len(MapKey(prefix="users", key=0)), comment=Box must have value) == len(reinterpret_cast<bytes>(value)), comment=box length must match the encoded length)
    return True
  }
  
  extractBox(): void
  {
    assert(box_create("blob", 32), comment=box must not exist yet)
    senderBytes: bytes[32] = reinterpret_cast<bytes[32]>(txn<Sender>())
    appAddress: bytes[32] = reinterpret_cast<bytes[32]>(global<CurrentApplicationAddress>())
    box_replace("blob", 0, reinterpret_cast<bytes>(senderBytes))
    box_resize("blob", 64 + len("hello"))
    box_splice("blob", 0, 0, reinterpret_cast<bytes>(appAddress))
    box_replace("blob", 64, "hello")
    prefix: bytes = box_extract("blob", 0, 64 + len("hello"))
    assert(prefix == concat(concat(reinterpret_cast<bytes>(appAddress), reinterpret_cast<bytes>(senderBytes)), "hello"), comment=unexpected box contents)
    STATE_DELETE(Box["blob"].value)
  }
  
  existBox(): readonly [bool, bool, bool, bool]
  {
    return #[STATE_EXISTS(Box["boxInt"].value), STATE_EXISTS(Box["b"].value), STATE_EXISTS(Box["BOX_STRING"].value), STATE_EXISTS(Box["BOX_BYTES"].value)]
  }
  
  sliceBox(): void
  {
    Box["scratch"].value: bytes = "Testing testing 123"
    assert(Box["scratch"].value.slice(0, 7) == "Testing", comment=box value must support slicing)
    Box["BOX_STRING"].value: arc4.dynamic_array<arc4.byte> = "Hello"
    assert(reinterpret_cast<bytes>(Box["BOX_STRING"].value).slice(2, 10) == "Hello", comment=unexpected string contents)
    STATE_DELETE(Box["scratch"].value)
  }
  
  arc4Box(): void
  {
    Box["d"].value: arc4.static_array<arc4.uint8,4> = new arc4.static_array<arc4.uint8,4>(0, 1, 2, 3)
    assert(ARC4_DECODE(Box["d"].value[0]) == 0, comment=first element must be 0)
    assert(ARC4_DECODE(Box["d"].value[3]) == 3, comment=last element must be 3)
    STATE_DELETE(Box["d"].value)
  }
  
  keyBox(): bytes
  {
    return "boxInt"
  }
  
  keyBoxExample(): void
  {
    assert("b" == "b", comment=key must match the explicit str key)
    assert("BOX_STRING" == "BOX_STRING", comment=key must match the explicit bytes key)
    assert("BOX_BYTES" == "BOX_BYTES", comment=key must match the explicit bytes key)
  }
  
  boxMapExists(key: uint64): bool
  {
    return STATE_EXISTS(Box[MapKey(prefix="", key=key)].value)
  }
  
  boxMapStructExists(key: uint64): bool
  {
    return STATE_EXISTS(Box[MapKey(prefix="users", key=key)].value)
  }
  
  keyPrefixBoxMap(): bytes
  {
    return ""
  }
  
  nestedStructWrite(value: uint64): void
  {
    Box["boxNested"].value: examples/devportal/box_storage/contract.algo.ts::NestedStruct = new examples/devportal/box_storage/contract.algo.ts::NestedStruct(a=($2 = #{ a: ($3 = #{ a: ($4 = #[value, #{ c: ($5 = #{ c: ($6 = #[value + 1, new arc4.dynamic_array<uint64>(), value + 2]).0, arr: $6.1, d: $6.2 }).c, arr: $5.arr, d: $5.d }, new arc4.dynamic_array<examples/devportal/box_storage/contract.algo.ts::InnerStruct>(), value + 3]).0, inner: $4.1, siblings: $4.2, b: $4.3 }).a, inner: $3.inner, siblings: $3.siblings, b: $3.b }).a, inner=new examples/devportal/box_storage/contract.algo.ts::InnerStruct(c=($7 = $2.inner).c, arr=$7.arr, d=$7.d), siblings=$2.siblings, b=$2.b)
    for (temp in urange(0, 3, 1)) {
      i: uint64 = copy(temp)
      Box["boxNested"].value.inner.arr.push(...#[i]), Box["boxNested"].value.inner.arr.length
    }
  }
  
  nestedStructSum(): uint64
  {
    total: uint64 = Box["boxNested"].value.a + Box["boxNested"].value.b
    total: uint64 = total + Box["boxNested"].value.inner.c + Box["boxNested"].value.inner.d
    for (temp in Box["boxNested"].value.inner.arr) {
      value: uint64 = copy(temp)
      total: uint64 = total + value
    }
    return total
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
subroutine getBoxMapValueFromKeyPlus1(boxMap: box_key, key: uint64): string
{
  return Box[MapKey(prefix=boxMap, key=key + 1)].value
}