contract LoggedErrors
{
  globals {
    ["balance"]: uint64
  }
  approvalProgram(): bool
  {
    if (!Boolean(txn<ApplicationID>())) {
      this.constructor()
    }
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  deposit(amount: uint64): uint64
  {
    GlobalState["balance"]: uint64 = GlobalState["balance"] + amount
    return GlobalState["balance"]
  }
  
  withdraw(amount: uint64): uint64
  {
    logged_assert(amount > 0, comment=ERR:amountError01:amount must be positive, desc=Withdrawal amount must be greater than zero)
    logged_assert(amount <= GlobalState["balance"], comment=ERR:amountError02:insufficient balance)
    GlobalState["balance"]: uint64 = GlobalState["balance"] - amount
    return GlobalState["balance"]
  }
  
  reject(code: uint64): uint64
  {
    if (code == 0) {
      logged_err(ERR:codeRange00:code zero is reserved)
    }
    if (code > 100) {
      logged_err(ERR:codeRange01:code out of range)
    }
    return code
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
  constructor(): void
  {
    super.constructor()
    GlobalState["balance"]: uint64 = 0
  }
  
  BaseContract::constructor(): void
  {
  }
  
}