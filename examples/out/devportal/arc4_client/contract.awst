    err(stub only)
  }
  
  HelloWorldClient::add(a: arc4.uint64, b: arc4.uint64): arc4.uint64
  {
    err(stub only)
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract ClientConsumer
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  callHello(app: application, name: arc4.dynamic_array<arc4.byte>): arc4.dynamic_array<arc4.byte>
  {
    #[result]: readonly [arc4.dynamic_array<arc4.byte>] = #[($0 = #{ itxn: ($1 = submit_txn(abi_call(signature={name="hello",args=(arc4.dynamic_array<arc4.byte>),result=arc4.dynamic_array<arc4.byte>}, args=(name), fields={Fee=0, TypeEnum=appl, ApplicationID=app}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($2 = $1.LastLog)), extract<0, 4>($2) == 0x151f7c75], comment=Bytes has valid prefix), wtype=arc4.dynamic_array<arc4.byte>, validate=true) }).returnValue]
    return result
  }
  
  callAdd(app: application, a: arc4.uint64, b: arc4.uint64): arc4.uint64
  {
    #[result, txn]: readonly [arc4.uint64, inner_transaction_appl] = #[($3 = #{ itxn: ($4 = submit_txn(abi_call(signature={name="add",args=(arc4.uint64,arc4.uint64),result=arc4.uint64}, args=(a, b), fields={Fee=0, TypeEnum=appl, ApplicationID=app}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($5 = $4.LastLog)), extract<0, 4>($5) == 0x151f7c75], comment=Bytes has valid prefix), wtype=arc4.uint64, validate=true) }).returnValue, $3.itxn]
    assert(txn.NumLogs == 1, comment=only the return log was emitted by the app)
    return result
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}