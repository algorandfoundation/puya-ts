contract HelloWorld
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  hello(name: arc4.dynamic_array<arc4.byte>): arc4.dynamic_array<arc4.byte>
  {
    return ARC4_ENCODE("Hello, " + ARC4_DECODE(name), wtype=arc4.dynamic_array<arc4.byte>)
  }
  
  add(a: arc4.uint64, b: arc4.uint64): arc4.uint64
  {
    return ARC4_ENCODE(ARC4_DECODE(a) + ARC4_DECODE(b), wtype=arc4.uint64)
  }
  
  HelloWorldClient::hello(name: arc4.dynamic_array<arc4.byte>): arc4.dynamic_array<arc4.byte>
  {
    err(stub only)
  }
  
  HelloWorldClient::add(a: arc4.uint64, b: arc4.uint64): arc4.uint64
  {
    err(stub only)
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract ChattyHelloWorld
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  hello(name: arc4.dynamic_array<arc4.byte>): arc4.dynamic_array<arc4.byte>
  {
    return ARC4_ENCODE("Hello, " + ARC4_DECODE(name), wtype=arc4.dynamic_array<arc4.byte>)
  }
  
  add(a: arc4.uint64, b: arc4.uint64): arc4.uint64
  {
    log("extra log entry")
    return ARC4_ENCODE(ARC4_DECODE(a) + ARC4_DECODE(b), wtype=arc4.uint64)
  }
  
  HelloWorldClient::hello(name: arc4.dynamic_array<arc4.byte>): arc4.dynamic_array<arc4.byte>
