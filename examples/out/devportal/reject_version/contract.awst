contract Hello
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  hello(name: string): string
  {
    return "Hello, " + name
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract RejectVersion
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  callPinned(target: application, maxVersion: uint64): string
  {
    #[returnValue]: readonly [string] = #[($0 = #{ itxn: ($1 = submit_txn(abi_call(signature={name="hello",args=(string),result=string}, args=("World"), fields={Fee=0, TypeEnum=appl, ApplicationID=target, RejectVersion=maxVersion + 1}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($2 = $1.LastLog)), extract<0, 4>($2) == 0x151f7c75], comment=Bytes has valid prefix), wtype=string, validate=true) }).returnValue]
    return returnValue
  }
  
  callChecked(target: application, unsafeVersion: uint64): string
  {
    assert(checked_maybe(app_params_get<AppVersion>(target), comment=application exists) > unsafeVersion, comment=target bug has not been patched yet)
    #[returnValue]: readonly [string] = #[($3 = #{ itxn: ($4 = submit_txn(abi_call(signature={name="hello",args=(string),result=string}, args=("World"), fields={Fee=0, TypeEnum=appl, ApplicationID=target}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($5 = $4.LastLog)), extract<0, 4>($5) == 0x151f7c75], comment=Bytes has valid prefix), wtype=string, validate=true) }).returnValue]
    return returnValue
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}