            "readonly": false,
            "desc": "Send an inner ApplicationCall that refuses to execute if `target`\nhas been upgraded past `maxVersion`.\n\n`rejectVersion = maxVersion + 1` means \"fail unless the callee's\nversion is <= maxVersion\". This is the canonical pattern for\npinning to \"the version I audited\", forward-compatible with whatever\nversion number the caller has actually audited.",
            "events": [],
            "recommendations": {}
        },
        {
