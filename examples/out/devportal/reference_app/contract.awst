contract Counter
{
  globals {
    ["counter"]: uint64
  }
  approvalProgram(): bool
  {
    if (!Boolean(txn<ApplicationID>())) {
      this.constructor()
    }
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  increment(): uint64
  {
    GlobalState["counter"]: uint64 = GlobalState["counter"] + 1
    return GlobalState["counter"]
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
  constructor(): void
  {
    super.constructor()
    GlobalState["counter"]: uint64 = 0
  }
  
  BaseContract::constructor(): void
  {
  }
  
}
contract ReferenceApp
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  incrementViaInner(): uint64
  {
    #[counterResult]: readonly [uint64] = #[($0 = #{ itxn: ($1 = submit_txn(abi_call(signature={name="increment",args=(),result=uint64}, args=(), fields={Fee=0, TypeEnum=appl, ApplicationID=TemplateVar[application](TMPL_KNOWN_APP)}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($2 = $1.LastLog)), extract<0, 4>($2) == 0x151f7c75], comment=Bytes has valid prefix), wtype=uint64, validate=true) }).returnValue]
    return counterResult
  }
  
  incrementViaInnerWithArg(app: application): uint64
  {
    #[counterResult]: readonly [uint64] = #[($3 = #{ itxn: ($4 = submit_txn(abi_call(signature={name="increment",args=(),result=uint64}, args=(), fields={Fee=0, TypeEnum=appl, ApplicationID=app}))), returnValue: ARC4_FROM_BYTES(checked_maybe(#[extract<4, 0>(($5 = $4.LastLog)), extract<0, 4>($5) == 0x151f7c75], comment=Bytes has valid prefix), wtype=uint64, validate=true) }).returnValue]
    return counterResult
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}