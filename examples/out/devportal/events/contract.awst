contract SwapContract
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  swapEmitStruct(sender: account, receiver: account, inAmount: uint64, outAmount: uint64): void
  {
    event: Swapped = new Swapped(sender=($0 = #{ sender: reinterpret_cast<arc4.static_array<arc4.byte,32>>(sender), receiver: reinterpret_cast<arc4.static_array<arc4.byte,32>>(receiver), inAmount: ARC4_ENCODE(inAmount, wtype=arc4.uint64), outAmount: ARC4_ENCODE(outAmount, wtype=arc4.uint64) }).sender, receiver=$0.receiver, inAmount=$0.inAmount, outAmount=$0.outAmount)
    emit("Swapped", event)
    nativeEvent: examples/devportal/events/contract.algo.ts::NativeStruct = new examples/devportal/events/contract.algo.ts::NativeStruct(count=($1 = #{ count: inAmount, message: "payment received" }).count, message=$1.message)
    emit("examples/devportal/events/contract.algo.ts::NativeStruct", nativeEvent)
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract TransferContract
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  transferEmitSignature(sender: account, receiver: account, amount: uint64): void
  {
    emit_fields(Transfer(address,address,uint64), (reinterpret_cast<arc4.static_array<arc4.byte,32>>(sender), reinterpret_cast<arc4.static_array<arc4.byte,32>>(receiver), ARC4_ENCODE(amount, wtype=arc4.uint64)))
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract MintContract
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  mintEmitByName(recipient: account, amount: uint64): void
  {
    emit_fields(Mint, (reinterpret_cast<arc4.static_array<arc4.byte,32>>(recipient), ARC4_ENCODE(amount, wtype=arc4.uint64)))
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}