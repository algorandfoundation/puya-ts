contract MyCounter
{
  locals {
    ["my_counter"]: uint64
  }
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  optIn(): void
  {
    LocalState[txn<Sender>()]["my_counter"]: uint64 = 0
  }
  
  incrementMyCounter(): uint64
  {
    assert(app_opted_in(txn<Sender>(), global<CurrentApplicationID>()), comment=Account is not opted in to the app)
    LocalState[txn<Sender>()]["my_counter"]: uint64 = LocalState[txn<Sender>()]["my_counter"] + 1
    return LocalState[txn<Sender>()]["my_counter"]
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}
contract ReferenceAccountApp
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  getMyCounter(): uint64
  {
    #[myCount, exists]: readonly [uint64, bool] = #[($0 = app_local_get_ex(TemplateVar[account](TMPL_KNOWN_ACCOUNT), TemplateVar[application](TMPL_KNOWN_APP), "my_counter")).0, $0.1]
    assert(exists, comment=my_counter is not set for this account)
    return myCount
  }
  
  getMyCounterWithArg(account: account, app: application): uint64
  {
    #[myCount, exists]: readonly [uint64, bool] = #[($1 = app_local_get_ex(account, app, "my_counter")).0, $1.1]
    assert(exists, comment=my_counter is not set for this account)
    return myCount
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}