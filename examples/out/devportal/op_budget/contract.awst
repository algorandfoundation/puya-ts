contract OpBudget
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  manyHashes(seed: bytes, rounds: uint64): bytes
  {
    ensure_budget(rounds * 40 + 100, 0)
    digest: bytes = seed
    for (temp in urange(0, rounds, 1)) {
      _i: uint64 = copy(temp)
      digest: bytes = reinterpret_cast<bytes>(sha256(digest))
    }
    return digest
  }
  
  manyHashesGroupCredit(seed: bytes, rounds: uint64): bytes
  {
    ensure_budget(rounds * 40 + 100, 0)
    digest: bytes = seed
    for (temp in urange(0, rounds, 1)) {
      _i: uint64 = copy(temp)
      digest: bytes = reinterpret_cast<bytes>(sha256(digest))
    }
    return digest
  }
  
  manyHashesAppPays(seed: bytes, rounds: uint64): bytes
  {
    ensure_budget(rounds * 40 + 100, 1)
    digest: bytes = seed
    for (temp in urange(0, rounds, 1)) {
      _i: uint64 = copy(temp)
      digest: bytes = reinterpret_cast<bytes>(sha256(digest))
    }
    return digest
  }
  
  manyHashesAny(seed: bytes, rounds: uint64): bytes
  {
    ensure_budget(rounds * 40 + 100, 2)
    digest: bytes = seed
    for (temp in urange(0, rounds, 1)) {
      _i: uint64 = copy(temp)
      digest: bytes = reinterpret_cast<bytes>(sha256(digest))
    }
    return digest
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}