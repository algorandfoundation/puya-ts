contract CryptoOps
{
  approvalProgram(): bool
  {
    return arc4Router()
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  hashes(data: bytes): readonly [bytes[32], bytes[32], bytes[32], bytes[32]]
  {
    return #[sha256(data), sha3_256(data), sha512_256(data), keccak256(data)]
  }
  
  ed25519(data: bytes, signature: bytes, publicKey: bytes): readonly [bool, bool]
  {
    bound: bool = ed25519verify(data, signature, publicKey)
    bare: bool = ed25519verify_bare(data, signature, publicKey)
    return #[bound, bare]
  }
  
  ecdsa(data: bytes, sigR: bytes, sigS: bytes, pubkeyX: bytes, pubkeyY: bytes): readonly [bool, bool]
  {
    k1: bool = ecdsa_verify<Secp256k1>(data, sigR, sigS, pubkeyX, pubkeyY)
    r1: bool = ecdsa_verify<Secp256r1>(data, sigR, sigS, pubkeyX, pubkeyY)
    return #[k1, r1]
  }
  
  ecdsaDecompress(compressedPubkey: bytes): readonly [bytes[32], bytes[32]]
  {
    return ecdsa_pk_decompress<Secp256k1>(compressedPubkey)
  }
  
  ecdsaRecover(digest: bytes, recoveryId: uint64, sigR: bytes, sigS: bytes): readonly [bytes[32], bytes[32]]
  {
    return ecdsa_pk_recover<Secp256k1>(digest, recoveryId, sigR, sigS)
  }
  
  vrf(message: bytes, proof: bytes, publicKey: bytes): readonly [bytes[64], bool]
  {
    return vrf_verify<VrfAlgorand>(message, proof, publicKey)
  }
  
  __algots__.defaultCreate(): void
  {
  }
  
}