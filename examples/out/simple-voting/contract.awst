contract SimpleVotingContract
{
  globals {
    ["topic"]: bytes
    ["votes"]: uint64
  }
  locals {
    ["voted"]: uint64
  }
  approvalProgram(): uint64
  {
    if (!Boolean(txn<ApplicationID>())) {
      this.constructor()
    }
    if (($0 = txnas<ApplicationArgs>(0)) == "set_topic") {
      #switch₁ᶜ₀:
      examples/simple-voting/contract.algo.ts::SimpleVotingContract.setTopic(txnas<ApplicationArgs>(1))
      return 1
      goto #switch₁ᶜ₁
    }
    if ($0 == "vote") {
      #switch₁ᶜ₁:
      return (examples/simple-voting/contract.algo.ts::SimpleVotingContract.vote(txn<Sender>()) ? 1 : 0)
      goto #switch₁ᶜ₂
    }
    if ($0 == "get_votes") {
      #switch₁ᶜ₂:
      return GlobalState["votes"]
      goto #switch₁ᶜ₃
    }
    #switch₁ᶜ₃:
    return 0
  }
  
  clearProgram(): bool
  {
    return True
  }
  
  setTopic(topic: bytes): void
  {
    GlobalState["topic"]: bytes = topic
  }
  
  vote(voter: account): bool
  {
    assert(global<GroupSize>() == 2)
    assert(gtxns<Amount>(1) == 10000)
    assert(gtxns<TypeEnum>(1) == reinterpret_cast<uint64>(1))
    if (STATE_EXISTS(LocalState[voter]["voted"])) {
      return False
    }
    GlobalState["votes"]: uint64 = GlobalState["votes"] + 1
    LocalState[voter]["voted"]: uint64 = 1
    return True
  }
  
  BaseContract::clearStateProgram(): bool
  {
    return True
  }
  
  constructor(): void
  {
    super.constructor()
    GlobalState["topic"]: bytes = "default_topic"
    GlobalState["votes"]: uint64 = 0
  }
  
  BaseContract::constructor(): void
  {
  }
  
}